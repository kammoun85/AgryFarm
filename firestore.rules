rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Farms collection and subcollections: Each user has their own private isolated farm
    match /farms/{farmId} {
      allow read, write: if isSignedIn() && request.auth.uid == farmId;

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == farmId;
      }
    }
  }
}
